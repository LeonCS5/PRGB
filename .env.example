# Copie para .env.local (ignorado pelo git) e preencha. Sem estas variáveis o app funciona normalmente,
# só sem ranking online.

# Supabase: Project Settings > API. A chave é a pública (anon ou publishable), protegida por RLS.
# Nunca coloque aqui a service_role/secret key.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica

# Opcional: chave do site (pública) do Cloudflare Turnstile, o CAPTCHA na criação da conta do ranking.
# Ligue o CAPTCHA no painel do Supabase (Authentication > Attack Protection) só depois de publicar com ela.
VITE_TURNSTILE_SITE_KEY=
